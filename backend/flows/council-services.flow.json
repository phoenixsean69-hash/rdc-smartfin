    {
      "id": "BILL_SERVICES",
      "title": "Council Billing",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "bill_services_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Manage your bills"
              },
              {
                "type": "TextBody",
                "text": "Choose the council service you want to enquire about."
              },
              {
                "type": "Dropdown",
                "name": "service",
                "label": "Billing service",
                "required": true,
                "data-source": [
                  {
                    "id": "water",
                    "title": "Water bills"
                  },
                  {
                    "id": "rates",
                    "title": "Property rates"
                  },
                  {
                    "id": "refuse",
                    "title": "Refuse collection"
                  },
                  {
                    "id": "market",
                    "title": "Market and stall fees"
                  },
                  {
                    "id": "land",
                    "title": "Land and stand charges"
                  },
                  {
                    "id": "licence",
                    "title": "Business licences"
                  },
                  {
                    "id": "rental",
                    "title": "Council rentals"
                  },
                  {
                    "id": "levy",
                    "title": "Other council levies"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "BILL_REQUEST"
                  },
                  "payload": {
                    "service": "${form.service}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "BILL_REQUEST",
      "title": "Billing Request",
      "terminal": true,
      "success": true,
      "data": {
        "service": {
          "type": "string",
          "__example__": "water"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "bill_request_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Your billing account"
              },
              {
                "type": "TextBody",
                "text": "Balances and payment instructions require identity verification. This form does not charge you."
              },
              {
                "type": "TextInput",
                "name": "account_reference",
                "label": "Account reference",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "request_type",
                "label": "What do you need?",
                "required": true,
                "data-source": [
                  {
                    "id": "balance",
                    "title": "Check my balance"
                  },
                  {
                    "id": "payment",
                    "title": "Request payment instructions"
                  },
                  {
                    "id": "statement",
                    "title": "Request a statement"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Submit billing request",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "journey": "billing",
                    "service": "${data.service}",
                    "account_reference": "${form.account_reference}",
                    "request_type": "${form.request_type}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PROBLEM",
      "title": "Report a Problem",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "problem_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Report a council issue"
              },
              {
                "type": "TextBody",
                "text": "Tell us what needs attention. Submission does not yet create a live council ticket."
              },
              {
                "type": "Dropdown",
                "name": "category",
                "label": "Problem category",
                "required": true,
                "data-source": [
                  {
                    "id": "water",
                    "title": "Water supply"
                  },
                  {
                    "id": "road",
                    "title": "Roads and drainage"
                  },
                  {
                    "id": "waste",
                    "title": "Refuse and waste"
                  },
                  {
                    "id": "lighting",
                    "title": "Street lighting"
                  },
                  {
                    "id": "sanitation",
                    "title": "Sanitation"
                  },
                  {
                    "id": "other",
                    "title": "Other or feedback"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "location",
                "label": "Area or ward",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "TextArea",
                "name": "description",
                "label": "Describe the problem",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Submit report",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "journey": "complaint",
                    "category": "${form.category}",
                    "location": "${form.location}",
                    "description": "${form.description}"
                  }
                }
              }
            ]
